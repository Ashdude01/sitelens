# Copy to .env and edit. Everything is optional; defaults work for local development.

SITE_NAME=SiteLens
PUBLIC_URL=http://localhost:3000

# Data folder (fingerprints, calibration.json, ground_truth.csv). Default: ./data
# DATA_DIR=
# Database. Default: SQLite file at <DATA_DIR>/sitelens.db. Also works with Turso: libsql://…
# DATABASE_URL=
# DATABASE_AUTH_TOKEN=

# Set to 1 behind Cloudflare / nginx so rate limits use the real visitor IP.
TRUST_PROXY=0
FRESH_SCANS_PER_HOUR=30
REPORT_TTL_HOURS=168

# Crawler identity. Put a real page explaining your bot.
USER_AGENT=Mozilla/5.0 (compatible; SiteLensBot/0.1; +https://yourdomain.com/bot)
BOT_TOKEN=SiteLensBot
RESPECT_ROBOTS=1

# Optional: headless browser pass (finds JavaScript-only tools). Uses installed Chrome/Chromium.
USE_BROWSER=0
# CHROMIUM_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Optional: free Google API key with the Chrome UX Report API enabled (real-user speed + device split).
CRUX_API_KEY=

# Optional: DataForSEO for Google organic traffic estimates (~$0.01 per lookup).
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# 2840 = United States, 2356 = India
DATAFORSEO_LOCATION_CODE=2840

# Google PageSpeed Insights (Core Web Vitals sidebar). Works without a key at a low quota;
# get a free key at https://developers.google.com/speed/docs/insights/v5/get-started
PAGESPEED_API_KEY=
PAGESPEED_TTL_HOURS=168
PAGESPEED_RUNS_PER_HOUR=20

# Where official technology logos are fetched from (then cached in DATA_DIR/icon-cache).
# TECH_ICON_UPSTREAM=https://raw.githubusercontent.com/enthec/webappanalyzer/main/src/images/icons/

RDAP_ENABLED=1
# Local testing only. NEVER enable in production (allows scanning private networks).
ALLOW_PRIVATE_NETWORK=0
